{
  "name": "@video-forge/toolkit",
  "version": "0.7.1",
  "description": "Code-authored short-form video direction, composable motion and editable local production for agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "video-forge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/finalize-build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.renderer.json && npm test && python3 scripts/validate_package.py",
    "vf": "tsx src/cli.ts",
    "examples": "tsx scripts/run-examples.ts",
    "package": "npm run build && python3 scripts/package.py",
    "setup:binaries": "node node_modules/ffmpeg-static/install.js && node node_modules/esbuild/install.js",
    "schema": "tsx scripts/export-schema.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.536",
    "@remotion/gsap": "4.0.536",
    "@remotion/motion-blur": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@remotion/three": "4.0.536",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "gsap": "3.15.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.536",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.186.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sanidhya14321/video-forge.git"
  },
  "homepage": "https://github.com/Sanidhya14321/video-forge",
  "bugs": {
    "url": "https://github.com/Sanidhya14321/video-forge/issues"
  }
}
