{
  "version": 1,
  "name": "reel-showcase",
  "workflow": "short-form-reel",
  "fps": 30,
  "reel": {
    "bpm": 160,
    "safeArea": "reels"
  },
  "theme": {
    "surface": "flat",
    "background": "#111111",
    "foreground": "#f4f4ef",
    "accent": "#f4f4ef",
    "muted": "#85857f",
    "font": "Arial, Helvetica, sans-serif"
  },
  "scenes": [
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "STOP\nSLIDES.",
      "motion": {
        "preset": "type-impact",
        "invert": false,
        "seed": 7,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Stop making slides."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "MAKE\nMOTION.",
      "motion": {
        "preset": "ribbon",
        "invert": false,
        "seed": 8,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Make motion."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "VIDEO\nFORGE",
      "motion": {
        "preset": "fragment-merge",
        "invert": true,
        "seed": 17,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Meet Video Forge."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "ONE\nBRIEF.",
      "motion": {
        "preset": "signal-flow",
        "invert": false,
        "seed": 10,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Start with one brief."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "CLAUDE.",
      "motion": {
        "preset": "orbit-lock",
        "invert": false,
        "seed": 17,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Use Claude.",
      "body": "/video-forge:video-forge"
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "CODEX.",
      "motion": {
        "preset": "orbit-lock",
        "invert": true,
        "seed": 17,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Or Codex.",
      "body": "$video-forge"
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "DESCRIBE\nIT.",
      "motion": {
        "preset": "type-impact",
        "invert": true,
        "seed": 13,
        "density": 8,
        "entrance": "push"
      },
      "note": "Describe your idea.",
      "body": "A 30-second launch reel."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "PLAN\nTHE STORY.",
      "motion": {
        "preset": "signal-flow",
        "invert": false,
        "seed": 14,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Plan the story."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "BUILD\nTHE MOTION.",
      "motion": {
        "preset": "radial-burst",
        "invert": false,
        "seed": 15,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Build the motion."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "CODE\nCOMES ALIVE.",
      "motion": {
        "preset": "code-scan",
        "invert": true,
        "seed": 16,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Bring code to life.",
      "body": "FRAME-DRIVEN. EDITABLE.",
      "code": "const f = useCurrentFrame();\nconst x = f * 4;"
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "MAKE\nDATA MOVE.",
      "motion": {
        "preset": "data-sculpt",
        "invert": false,
        "seed": 17,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Make data move.",
      "body": "SUPPLIED EXAMPLE DATA",
      "values": [
        3,
        8,
        5,
        11
      ],
      "labels": [
        "A",
        "B",
        "C",
        "D"
      ],
      "highlight": [
        3
      ]
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "CUT\nTHE PAUSE.",
      "motion": {
        "preset": "timeline-cut",
        "invert": false,
        "seed": 18,
        "density": 8,
        "entrance": "push"
      },
      "note": "Cut the pauses."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "FIND\nTHE FRAME.",
      "motion": {
        "preset": "frame-morph",
        "invert": true,
        "seed": 19,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Find the right frame."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "GIVE IT\nA VOICE.",
      "motion": {
        "preset": "waveform",
        "invert": false,
        "seed": 20,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Give it a voice."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "WORDS\nIN SYNC.",
      "motion": {
        "preset": "word-pulse",
        "invert": true,
        "seed": 21,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Put words in sync.",
      "labels": [
        "VOICE",
        "MUSIC",
        "WORDS"
      ]
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "LET RHYTHM\nLEAD.",
      "motion": {
        "preset": "ribbon",
        "invert": false,
        "seed": 22,
        "density": 8,
        "entrance": "push"
      },
      "note": "Let the rhythm lead."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "EVERY\nSCREEN.",
      "motion": {
        "preset": "frame-morph",
        "invert": false,
        "seed": 23,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Fit every screen.",
      "body": "9:16 / 16:9 / 1:1 / 4:5"
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "KEEP\nTHE SOURCE.",
      "motion": {
        "preset": "fragment-merge",
        "invert": true,
        "seed": 17,
        "density": 8,
        "entrance": "cut"
      },
      "note": "Keep every source.",
      "body": "COMPOSITION + ASSETS + CAPTIONS"
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "ONE\nWORKFLOW.",
      "motion": {
        "preset": "orbit-lock",
        "invert": false,
        "seed": 17,
        "density": 8,
        "entrance": "cut"
      },
      "note": "One connected workflow."
    },
    {
      "kind": "reel",
      "duration": 1.5,
      "title": "BRIEF.\nTO FILM.",
      "motion": {
        "preset": "type-impact",
        "invert": true,
        "seed": 26,
        "density": 8,
        "entrance": "cut"
      },
      "note": "From brief to film.",
      "body": "VIDEO FORGE / CLAUDE + CODEX"
    }
  ],
  "narration": {
    "provider": "file",
    "src": "assets/reel/voice.wav"
  },
  "captions": {
    "transcript": "assets/reel/transcript.json",
    "maxWords": 3
  },
  "music": {
    "src": "assets/reel/score.wav",
    "volume": 0.22
  },
  "exports": [
    {
      "preset": "vertical"
    }
  ],
  "assets": [
    {
      "path": "assets/reel/voice.wav",
      "origin": "Local Kokoro af_heart AI narration, original authored script",
      "license": "Synthetic model output; Kokoro model terms apply separately"
    },
    {
      "path": "assets/reel/score.wav",
      "origin": "Original Python-synthesized 160 BPM score and sound effects",
      "license": "MIT"
    }
  ]
}
