{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "jsx": "react-jsx", "esModuleInterop": true,
    "resolveJsonModule": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true, "declaration": true
  },
  "include": ["src/**/*"]
}
