{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "workflow": {
      "type": "string",
      "enum": [
        "product-demo",
        "algorithm-explainer",
        "footage-repurpose",
        "short-form-reel"
      ]
    },
    "renderer": {
      "default": "remotion",
      "type": "string",
      "const": "remotion"
    },
    "fps": {
      "default": 30,
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "theme": {
      "default": {
        "surface": "flat",
        "background": "#0b1020",
        "foreground": "#f1f5f9",
        "accent": "#68e0cf",
        "muted": "#a8b3cc",
        "font": "Arial, sans-serif",
        "brand": "",
        "tagline": ""
      },
      "type": "object",
      "properties": {
        "surface": {
          "default": "flat",
          "type": "string",
          "enum": [
            "flat",
            "ambient"
          ]
        },
        "background": {
          "default": "#0b1020",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
          "default": "#f1f5f9",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "default": "#68e0cf",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "default": "#a8b3cc",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
          "default": "Arial, sans-serif",
          "type": "string",
          "maxLength": 80
        },
        "brand": {
          "default": "",
          "type": "string",
          "maxLength": 80
        },
        "tagline": {
          "default": "",
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "surface",
        "background",
        "foreground",
        "accent",
        "muted",
        "font",
        "brand",
        "tagline"
      ],
      "additionalProperties": false
    },
    "reel": {
      "type": "object",
      "properties": {
        "bpm": {
          "default": 160,
          "type": "number",
          "minimum": 60,
          "maximum": 200
        },
        "safeArea": {
          "default": "reels",
          "type": "string",
          "enum": [
            "reels",
            "clean"
          ]
        }
      },
      "required": [
        "bpm",
        "safeArea"
      ],
      "additionalProperties": false
    },
    "scenes": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "title",
              "code",
              "chart",
              "algorithm",
              "image",
              "video",
              "reel"
            ]
          },
          "duration": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 600
          },
          "title": {
            "default": "",
            "type": "string",
            "maxLength": 100
          },
          "eyebrow": {
            "type": "string",
            "maxLength": 80
          },
          "body": {
            "type": "string",
            "maxLength": 350
          },
          "code": {
            "type": "string",
            "maxLength": 2400
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "labels": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "note": {
            "type": "string",
            "maxLength": 200
          },
          "motion": {
            "type": "object",
            "properties": {
              "preset": {
                "type": "string",
                "enum": [
                  "type-impact",
                  "fragment-merge",
                  "orbit-lock",
                  "signal-flow",
                  "ribbon",
                  "frame-morph",
                  "timeline-cut",
                  "waveform",
                  "code-scan",
                  "data-sculpt",
                  "word-pulse",
                  "radial-burst"
                ]
              },
              "invert": {
                "default": false,
                "type": "boolean"
              },
              "seed": {
                "default": 7,
                "type": "integer",
                "minimum": 0,
                "maximum": 99999
              },
              "density": {
                "default": 8,
                "type": "integer",
                "minimum": 3,
                "maximum": 16
              },
              "entrance": {
                "default": "cut",
                "type": "string",
                "enum": [
                  "cut",
                  "push",
                  "scale"
                ]
              }
            },
            "required": [
              "preset",
              "invert",
              "seed",
              "density",
              "entrance"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "duration",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "footage": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "segments": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "removeSilence": {
          "default": false,
          "type": "boolean"
        },
        "silenceDb": {
          "default": -35,
          "type": "number",
          "minimum": -80,
          "maximum": -10
        },
        "silenceSeconds": {
          "default": 0.6,
          "type": "number",
          "minimum": 0.2,
          "maximum": 10
        },
        "crop": {
          "default": "contain",
          "type": "string",
          "enum": [
            "contain",
            "cover"
          ]
        }
      },
      "required": [
        "src",
        "removeSilence",
        "silenceDb",
        "silenceSeconds",
        "crop"
      ],
      "additionalProperties": false
    },
    "narration": {
      "default": {
        "provider": "none",
        "voice": "af_heart"
      },
      "type": "object",
      "properties": {
        "provider": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "file",
            "kokoro",
            "openai"
          ]
        },
        "src": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "voice": {
          "default": "af_heart",
          "type": "string",
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "maxLength": 100
        },
        "rateUsdPerMillionCharacters": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "provider",
        "voice"
      ],
      "additionalProperties": false
    },
    "captions": {
      "type": "object",
      "properties": {
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "text",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "transcript": {
          "type": "string"
        },
        "transcribe": {
          "default": false,
          "type": "boolean"
        },
        "language": {
          "default": "en",
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "model": {
          "default": "base",
          "type": "string",
          "enum": [
            "tiny",
            "base",
            "small",
            "medium",
            "large-v3",
            "turbo"
          ]
        },
        "maxWords": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "transcribe",
        "language",
        "model",
        "maxWords"
      ],
      "additionalProperties": false
    },
    "music": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "volume": {
          "default": 0.12,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "src",
        "volume"
      ],
      "additionalProperties": false
    },
    "generation": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "provider": {
            "type": "string",
            "const": "fal"
          },
          "endpoint": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+\\/[a-zA-Z0-9_\\/-]+$"
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "maxCostUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "resultType": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          }
        },
        "required": [
          "id",
          "provider",
          "endpoint",
          "input",
          "maxCostUsd",
          "resultType"
        ],
        "additionalProperties": false
      }
    },
    "cloud": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "maxUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "reservedUsd": {
          "default": 0,
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "maxUsd",
        "reservedUsd"
      ],
      "additionalProperties": false
    },
    "exports": {
      "default": [
        {
          "preset": "landscape"
        }
      ],
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "landscape",
              "vertical",
              "square",
              "portrait"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 240,
            "maximum": 3840
          },
          "height": {
            "type": "integer",
            "minimum": 240,
            "maximum": 3840
          }
        },
        "required": [
          "preset"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "credit": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "origin",
          "license"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "name",
    "workflow",
    "renderer",
    "fps",
    "theme",
    "scenes",
    "narration",
    "generation",
    "exports",
    "assets"
  ],
  "additionalProperties": false
}
