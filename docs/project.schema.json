          "const": 30
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "theme": {
      "default": {
        "surface": "flat",
        "background": "#0b1020",
        "foreground": "#f1f5f9",
        "accent": "#68e0cf",
        "muted": "#a8b3cc",
        "font": "Arial, sans-serif",
        "brand": "",
        "tagline": ""
