  "theme": {
    "background": "#0b1020",
    "foreground": "#f1f5f9",
    "accent": "#68e0cf",
    "muted": "#a8b3cc",
    "font": "Arial, sans-serif",
    "brand": "",
    "tagline": ""
  },
  "scenes": [],
  "footage": {
    "src": "assets/sample-recording.mp4",
